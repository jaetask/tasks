{
  "name": "tasks",
  "version": "0.1.0",
  "description": "Task management for AI agents: agents find work, claim tickets, report progress and hand work on; a person watches the board and joins in.",
  "author": "jaetask",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/jaetask/tasks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaetask/tasks.git"
  },
  "bugs": "https://github.com/jaetask/tasks/issues",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-page.mjs",
    "typecheck": "tsc --noEmit && tsc -p page",
    "test": "tsx --test src/*.test.ts src/*/*.test.ts",
    "expect": "node scripts/build-page.mjs && tsx expect/snap.ts",
    "lint": "biome lint . && npm run check:docs && npm run check:toolkit && node .agents/guardrails/check-comments.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "prepare": "git config core.hooksPath .agents/guardrails/hooks || true",
    "check:docs": "node scripts/check-docs.mjs",
    "start": "node dist/main.js",
    "dev": "node scripts/build-page.mjs && tsx src/main.ts",
    "connect": "tsx src/connect.ts",
    "check:page": "node scripts/build-page.mjs && node scripts/check-page.mjs",
    "build:page": "node scripts/build-page.mjs",
    "check:toolkit": "toolkit-guard page"
  },
  "dependencies": {
    "@jaetask/open-agent-kit": "0.2.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@jaetask/snap": "0.1.0",
    "@jaetask/toolkit": "git+https://github.com/jaetask/toolkit.git#9c618ed5ab2120385ad532f92b59ee936e06393a",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
