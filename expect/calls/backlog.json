    { "as": "a1", "call": "tickets.backlog-read", "input": { "project": "TLK", "text": "two" } },
    { "call": "history.change-undo", "input": { "change": "h9" } },
    { "as": "a1", "call": "tickets.ticket-archive", "input": { "ticket": "TLK-3" } },
    { "call": "tickets.ticket-restore", "input": { "ticket": "TLK-3" } }
