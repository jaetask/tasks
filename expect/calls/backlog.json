      "input": { "project": "TLK", "title": "Waiting two", "backlog": true }
    },
    { "as": "a1", "call": "tickets.backlog-read", "input": { "project": "TLK" } },
    { "as": "a1", "call": "tickets.work-find" },
    { "as": "a1", "call": "tickets.board-read", "input": { "project": "TLK" } },
    { "as": "a1", "call": "tickets.ticket-claim", "input": { "ticket": "TLK-2" } },
    { "as": "a1", "call": "tickets.ticket-move", "input": { "ticket": "TLK-2", "column": "c3" } },
